{
  "provider": "qwen-mt",
  "model": "qwen-mt-flash",
  "source_language": "es",
  "target_language": "zh-CN",
  "protocol": "openai_compatible",
  "timeout": 60,
  "max_retries": 2,
  "backoff_seconds": 5,
  "rate": 0.5,
  "fields": [
    "title_es_raw",
    "brand",
    "feature_bullets_es",
    "description_es",
    "product_details_es",
    "selected_variant_es",
    "specification_es",
    "category_l1",
    "category_l2",
    "category_l3",
    "leaf_category"
  ],
  "note": "API key is read only from QWEN_API_KEY or DASHSCOPE_API_KEY; endpoint may be supplied explicitly."
}
